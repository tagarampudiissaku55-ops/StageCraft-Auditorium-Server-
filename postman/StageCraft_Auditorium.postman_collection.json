  "item": [
    {
      "name": "1. Twist Tests (Sorted Lists)",
      "item": [
        {
          "name": "Test 1: sort=name&order=asc -> 200 (A to Z)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/speakers?sort=name&order=asc",
              "host": ["{{baseUrl}}"],
              "path": ["speakers"],
              "query": [
                { "key": "sort", "value": "name" },
                { "key": "order", "value": "asc" }
              ]
            },
            "description": "Test 1 required by brief: Sorts speakers alphabetically from A to Z with status 200."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"List is sorted alphabetically A to Z\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.be.an('array');",
                  "    pm.expect(data.length).to.be.above(0);",
                  "    for (let i = 0; i < data.length - 1; i++) {",
                  "        pm.expect(data[i].name.localeCompare(data[i + 1].name)).to.be.at.most(0);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Test 2: sort=name&order=desc -> 200 (Z to A)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/speakers?sort=name&order=desc",
              "host": ["{{baseUrl}}"],
              "path": ["speakers"],
              "query": [
                { "key": "sort", "value": "name" },
                { "key": "order", "value": "desc" }
              ]
            },
            "description": "Test 2 required by brief: Sorts speakers alphabetically from Z to A with status 200."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"List is sorted alphabetically Z to A\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.be.an('array');",
                  "    pm.expect(data.length).to.be.above(0);",
                  "    for (let i = 0; i < data.length - 1; i++) {",
                  "        pm.expect(data[i].name.localeCompare(data[i + 1].name)).to.be.at.least(0);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Test 3: sort=colour -> 400 (\"Cannot sort by that field\")",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/speakers?sort=colour",
              "host": ["{{baseUrl}}"],
              "path": ["speakers"],
              "query": [
                { "key": "sort", "value": "colour" }
              ]
            },
            "description": "Test 3 required by brief: Unknown sort field returns 400 and 'Cannot sort by that field'."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Message is 'Cannot sort by that field'\", function () {",
                  "    const data = pm.response.json();",
